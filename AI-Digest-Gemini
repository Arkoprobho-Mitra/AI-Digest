// ── Main entry point ────────────────────────────────────────────
function sendDailyDigest() {
  var props     = PropertiesService.getScriptProperties();
  var projectId = props.getProperty('GCP_PROJECT_ID');
  var region    = props.getProperty('VERTEX_REGION') || 'us-central1';
  if (!projectId) throw new Error('GCP_PROJECT_ID not set in Script Properties.');

  var nowMs      = new Date().getTime();
  var lastRunStr = props.getProperty('LAST_RUN_TIME');
  var lastRunMs  = lastRunStr
    ? parseInt(lastRunStr, 10)
    : nowMs - (14 * 60 * 60 * 1000);

  Logger.log('Fetching articles after: ' + new Date(lastRunMs).toLocaleString());
  var articles = fetchRSSArticles(lastRunMs);
  Logger.log('Raw articles in window: ' + articles.length);

  if (articles.length === 0) {
    Logger.log('No new articles — skipping email.');
    props.setProperty('LAST_RUN_TIME', nowMs.toString());
    return;
  }

  // Step 1: Local weighted scoring — zero cost
  articles = articles.map(scoreArticle);
  articles.sort(function (a, b) { return b.score - a.score; });
  Logger.log('Top score: ' + articles[0].score + ' — ' + articles[0].title);

  // Step 2: Flash-Lite dedupes + selects best 15 (~$0.001)
  var top40 = articles.slice(0, 40);
  Logger.log('Stage 1 (Flash-Lite): filtering ' + top40.length + ' → 15...');
  var top15 = filterWithFlashLite(top40, projectId, region);
  Logger.log('Stage 1 done: ' + top15.length + ' articles');

  // Step 3: Flash summarises the clean 15 (~$0.002–0.003)
  Logger.log('Stage 2 (Flash): summarising ' + top15.length + ' articles...');
  var digest = summariseWithFlash(top15, projectId, region);

  var hour    = new Date().getHours();
  var edition = hour < 12 ? '🌅 Morning Edition' : '🌇 Evening Edition';
  var subject = '[AI Digest] ' + digest.date + ' — ' + edition;
  var email   = Session.getActiveUser().getEmail();

  GmailApp.sendEmail(email, subject,
    'Your mail client does not support HTML.',
    { htmlBody: buildEmailHTML(digest, edition), name: 'AI Daily Digest' }
  );
  Logger.log('✅ Digest sent to ' + email);

  props.setProperty('LAST_RUN_TIME', nowMs.toString());
}

// ── Fetch & filter articles from RSS ───────────────────────────
function fetchRSSArticles(lastRunMs) {
  var allKws   = KEYWORDS_W3.concat(KEYWORDS_W2).concat(KEYWORDS_W1);
  var articles = [], seen = {};

  for (var f = 0; f < RSS_FEEDS.length; f++) {
    var feedUrl = RSS_FEEDS[f];
    try {
      var resp = UrlFetchApp.fetch(feedUrl, {
        muteHttpExceptions: true, followRedirects: true,
        headers: { 'User-Agent': 'Mozilla/5.0 (compatible; GAS-Digest/1.0)' },
      });
      if (resp.getResponseCode() !== 200) continue;

      var root    = XmlService.parse(resp.getContentText()).getRootElement();
      var channel = root.getChild('channel');
      var items   = channel
        ? channel.getChildren('item')
        : root.getChildren('entry', XmlService.getNamespace('http://www.w3.org/2005/Atom'));

      var isAiOnly = false;
      for (var a = 0; a < AI_ONLY_SOURCES.length; a++) {
        if (feedUrl.indexOf(AI_ONLY_SOURCES[a]) !== -1) { isAiOnly = true; break; }
      }

      for (var i = 0; i < Math.min((items || []).length, 8); i++) {
        try {
          var title = xmlText(items[i], 'title');
          if (!title) continue;

          var pubMs = xmlDate(items[i]);
          if (pubMs && pubMs <= lastRunMs) continue;

          var key = title.toLowerCase().slice(0, 80);
          if (seen[key]) continue;

          var url  = xmlLink(items[i]);
          var desc = (xmlText(items[i], 'description') || xmlText(items[i], 'summary') || '')
                      .replace(/<[^>]*>/g, '')   // strip HTML tags
                      .replace(/&amp;/g,  '&')   // decode common HTML entities
                      .replace(/&lt;/g,   '<')
                      .replace(/&gt;/g,   '>')
                      .replace(/&quot;/g, '"')
                      .replace(/&#39;/g,  "'")
                      .slice(0, 500).trim();

          if (!isAiOnly) {
            var body = (title + ' ' + desc).toLowerCase();
            var relevant = false;
            for (var k = 0; k < allKws.length; k++) {
              if (body.indexOf(allKws[k]) !== -1) { relevant = true; break; }
            }
            if (!relevant) continue;
          }

          seen[key] = true;
          articles.push({
            title:  title,
            url:    url || feedUrl,
            desc:   desc,
            source: feedUrl.replace(/https?:\/\/(www\.|feeds\.|feedburner\.|rss\.)?/, '')
                           .split('/')[0],
            score:  0,
          });
        } catch (e2) {}
      }
    } catch (e) {
      Logger.log('Feed error (' + feedUrl + '): ' + e.message);
    }
  }
  return articles;
}

// ── XML helpers ─────────────────────────────────────────────────
function xmlText(el, tag) {
  try { var c = el.getChild(tag); return c ? (c.getText() || null) : null; }
  catch (e) { return null; }
}
function xmlLink(el) {
  try {
    var a = el.getChild('link', XmlService.getNamespace('http://www.w3.org/2005/Atom'));
    if (a) { var h = a.getAttribute('href'); if (h) return h.getValue(); }
    var r = el.getChild('link');
    if (r) { var t = r.getText(); if (t && t.indexOf('http') === 0) return t; }
    var g = el.getChild('guid');
    if (g) { var u = g.getText(); if (u && u.indexOf('http') === 0) return u; }
  } catch (e) {}
  return null;
}
function xmlDate(el) {
  try {
    var ns = XmlService.getNamespace('http://www.w3.org/2005/Atom');
    var d  = xmlText(el, 'pubDate')
          || (el.getChild('updated',   ns) ? el.getChild('updated',   ns).getText() : null)
          || (el.getChild('published', ns) ? el.getChild('published', ns).getText() : null);
    if (d) { var ms = new Date(d).getTime(); if (!isNaN(ms)) return ms; }
  } catch (e) {}
  return null;
}

// ── Text sanitiser — strip characters that corrupt JSON output ──
// Removes control chars, normalises whitespace, escapes are NOT needed
// here because this text goes INTO the prompt (plain text), not into
// a JSON string we build ourselves. Flash then writes the JSON.
function sanitise(text) {
  return String(text || '')
    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '') // control chars
    .replace(/\r\n|\r/g, ' ')                            // CRLF → space
    .replace(/\n/g, ' ')                                 // LF → space
    .replace(/\t/g, ' ')                                 // tab → space
    .replace(/\s{2,}/g, ' ')                             // collapse spaces
    .replace(/[^\x20-\x7E\u00A0-\uFFFF]/g, '')          // non-printable
    .trim();
}

