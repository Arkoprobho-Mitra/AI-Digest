// ── Shared Vertex AI caller with retry ──────────────────────────
function callGemini(model, prompt, maxTokens, projectId, region, schema) {
  var endpoint = 'https://' + region + '-aiplatform.googleapis.com/v1/projects/' +
                 projectId + '/locations/' + region +
                 '/publishers/google/models/' + model + ':generateContent';

  var payload = {
    contents: [{ role: 'user', parts: [{ text: prompt }] }],
    generationConfig: {
      temperature: 0.1,
      maxOutputTokens: maxTokens,
      responseMimeType: 'application/json',
    },
  };
  if (schema) payload.generationConfig.responseSchema = schema;

  var lastError = null;
  for (var attempt = 1; attempt <= MAX_RETRIES; attempt++) {
    try {
      var resp = UrlFetchApp.fetch(endpoint, {
        method: 'post',
        contentType: 'application/json',
        headers: { 'Authorization': 'Bearer ' + ScriptApp.getOAuthToken() },
        payload: JSON.stringify(payload),
        muteHttpExceptions: true,
      });

      var httpCode = resp.getResponseCode();
      var body     = resp.getContentText();

      if (httpCode === 429 || httpCode === 503) {
        var delay = RETRY_DELAY_MS * attempt;
        Logger.log('Rate limit / overload (HTTP ' + httpCode + '), retrying in ' + delay + 'ms (attempt ' + attempt + '/' + MAX_RETRIES + ')');
        Utilities.sleep(delay);
        lastError = new Error('HTTP ' + httpCode);
        continue;
      }

      // FIX: Also retry on 500 (internal server error) — Vertex occasionally returns these transiently
      if (httpCode === 500) {
        var delay500 = RETRY_DELAY_MS * attempt;
        Logger.log('Internal server error (HTTP 500), retrying in ' + delay500 + 'ms (attempt ' + attempt + '/' + MAX_RETRIES + ')');
        Utilities.sleep(delay500);
        lastError = new Error('HTTP 500');
        continue;
      }

      var data = JSON.parse(body);
      if (data.error) {
        lastError = new Error('Vertex (' + model + '): ' + data.error.message);
        Logger.log('API error attempt ' + attempt + ': ' + lastError.message);
        if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
        continue;
      }

      var candidates = data.candidates || [];
      if (!candidates.length) {
        lastError = new Error('No candidates returned from ' + model);
        if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
        continue;
      }

      // FIX: Check for blocked/filtered responses (safety filters)
      var finishReason = candidates[0].finishReason || '';
      if (finishReason === 'SAFETY' || finishReason === 'BLOCKED') {
        Logger.log('Response blocked by safety filter (reason: ' + finishReason + ') attempt ' + attempt);
        lastError = new Error('Response blocked: ' + finishReason);
        if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
        continue;
      }

      var parts = (candidates[0].content || {}).parts || [];
      if (!parts.length) {
        lastError = new Error('No parts in candidate from ' + model);
        if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
        continue;
      }

      var raw = parts[0].text || '';
      raw = raw.replace(/^```json\s*/i, '').replace(/\s*```$/i, '').trim();
      
      // NEW: Catch token usage
      if (data.usageMetadata) {
        TOKEN_TRACKER[model].in += (data.usageMetadata.promptTokenCount || 0);
        TOKEN_TRACKER[model].out += (data.usageMetadata.candidatesTokenCount || 0);
      }

      return raw; // success
    } catch (e) {
      lastError = e;
      Logger.log('callGemini exception attempt ' + attempt + ': ' + e.message);
      if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
    }
  }
  throw new Error('callGemini failed after ' + MAX_RETRIES + ' attempts: ' + (lastError ? lastError.message : 'unknown'));
}

// ── Robust JSON extractor ───────────────────────────────────────
// FIX #5: Validates structural integrity after parsing
function extractJSON(raw) {
  var parsed = null;

  // Attempt 1: direct parse
  try { parsed = JSON.parse(raw); } catch (e) {}

  // Attempt 2: strip markdown fences
  if (!parsed) {
    var clean = raw.replace(/^```json\s*/i, '').replace(/\s*```$/i, '').trim();
    try { parsed = JSON.parse(clean); } catch (e) {}

    // Attempt 3: find first { ... } block using balanced brace matching
    if (!parsed) {
      var start = clean.indexOf('{');
      if (start !== -1) {
        // FIX: Use balanced brace matching instead of naive lastIndexOf
        var depth = 0;
        var inString = false;
        var escapeNext = false;
        var end = -1;
        for (var ci = start; ci < clean.length; ci++) {
          var ch = clean[ci];
          if (escapeNext) { escapeNext = false; continue; }
          if (ch === '\\' && inString) { escapeNext = true; continue; }
          if (ch === '"') { inString = !inString; continue; }
          if (inString) continue;
          if (ch === '{') depth++;
          if (ch === '}') { depth--; if (depth === 0) { end = ci; break; } }
        }
        if (end !== -1) {
          try { parsed = JSON.parse(clean.slice(start, end + 1)); } catch (e) {}
        }
      }
    }
  }

  if (!parsed) {
    Logger.log('All JSON parse attempts failed. Raw (500 chars): ' + raw.slice(0, 500));
    throw new Error('JSON parse failed for response: ' + raw.slice(0, 200));
  }

  // FIX: Structural validation — ensure parsed result is an object
  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
    throw new Error('JSON parsed but result is not an object: ' + typeof parsed);
  }

  // If it has an 'items' key, validate it's an array of objects
  if (parsed.items !== undefined) {
    if (!Array.isArray(parsed.items)) {
      Logger.log('WARN: parsed.items is not an array, wrapping: ' + typeof parsed.items);
      parsed.items = [];
    }
    // Filter out non-object entries from items
    parsed.items = parsed.items.filter(function (item) {
      return item && typeof item === 'object' && !Array.isArray(item) && typeof item.index !== 'undefined';
    });
  }

  // If it has a 'selected' key, validate it's an array of numbers
  if (parsed.selected !== undefined) {
    if (!Array.isArray(parsed.selected)) {
      Logger.log('WARN: parsed.selected is not an array: ' + typeof parsed.selected);
      parsed.selected = [];
    }
    parsed.selected = parsed.selected.filter(function (n) {
      return typeof n === 'number' && !isNaN(n) && isFinite(n);
    });
  }

  return parsed;
}

// ── Stage 1: Flash-Lite — dedupe & select 45 best ──────────────
function filterWithFlashLite(articles, projectId, region) {
  var list = articles.map(function (a, i) {
    return (i + 1) + '. [score:' + a.score + '] ' + sanitise(a.title) +
           ' | ' + a.source + ' | ' + sanitise(a.desc).slice(0, 100);
  }).join('\n');

  var prompt =
    'You are an AI news editor. ' + articles.length + ' pre-scored articles below.\n\n' +
    'Select exactly 45 best articles (or all if fewer):\n' +
    '- Remove duplicates — same story from multiple sources, keep highest score\n' +
    '- Remove off-topic articles (not genuinely about AI/ML/data science)\n' +
    '- Deprioritise: opinion pieces, tutorials, generic listicles\n' +
    '- Prioritise: model releases, research papers, lab announcements, benchmarks, breakthroughs\n\n' +
    'ARTICLES:\n' + list + '\n\n' +
    'Return JSON with key "selected" containing an array of 1-indexed integers.\n' +
    'Example: {"selected":[1,4,7,9,11,12,13,15,17,19,21,23,25,27,30,32,34,36,38,40,42,44,45,46,48]}';

  try {
    var raw    = callGemini('gemini-2.5-flash-lite', prompt, 8000, projectId, region, FILTER_SCHEMA);
    var parsed = extractJSON(raw);
    var sel    = (parsed.selected || [])
      // FIX: Ensure indices are valid integers within range (Math.floor handles floats)
      .map(function (n) { return Math.floor(n); })
      .filter(function (n) { return typeof n === 'number' && !isNaN(n) && n >= 1 && n <= articles.length; })
      // FIX: Deduplicate indices in case model returns duplicates
      .filter(function (n, idx, arr) { return arr.indexOf(n) === idx; })
      .map(function (n) { return articles[n - 1]; });

    if (sel.length >= 20) {
      Logger.log('Flash-Lite selected: ' + sel.length + ' articles');
      return sel;
    }
    Logger.log('Flash-Lite returned too few (' + sel.length + ') — using top 45 by score');
  } catch (e) {
    Logger.log('Flash-Lite error: ' + e.message + ' — using top 45 by score');
  }
  return articles.slice(0, 45);
}

// ── Safe timezone getter ────────────────────────────────────────
// FIX #4: Prevents crash if Session.getScriptTimeZone() returns null/empty
function safeTimezone() {
  try {
    var tz = Session.getScriptTimeZone();
    if (tz && tz.length > 0) return tz;
  } catch (e) {
    Logger.log('WARN: Could not get script timezone: ' + e.message);
  }
  return 'UTC'; // safe default
}

// ── Safe date formatter ─────────────────────────────────────────
// FIX #4: Wraps Utilities.formatDate with fallback
function safeFormatDate(date, pattern) {
  try {
    return Utilities.formatDate(date, safeTimezone(), pattern);
  } catch (e) {
    Logger.log('WARN: formatDate failed: ' + e.message);
    // Manual fallback for 'MMMM d, yyyy' pattern
    var months = ['January','February','March','April','May','June',
                  'July','August','September','October','November','December'];
    return months[date.getMonth()] + ' ' + date.getDate() + ', ' + date.getFullYear();
  }
}

// ── Stage 2: Chunked summarisation ─────────────────────────────
// Splits candidatePool into CHUNK_SIZE chunks, summarises each,
// then merges and enforces global deduplication + section caps.
function summariseInChunks(candidatePool, projectId, region) {
  // FIX #4: Use safe date formatting
  var today = safeFormatDate(new Date(), 'MMMM d, yyyy');

  var allResults = []; // flat array of {tier, title, source, url, summary, why_it_matters, significance, score}

  // Split into chunks
  var chunks = [];
  for (var start = 0; start < candidatePool.length; start += CHUNK_SIZE) {
    chunks.push(candidatePool.slice(start, start + CHUNK_SIZE));
  }
  Logger.log('Summarising in ' + chunks.length + ' chunk(s) of up to ' + CHUNK_SIZE + ' articles');

  for (var c = 0; c < chunks.length; c++) {
    var chunk        = chunks[c];
    var globalOffset = c * CHUNK_SIZE; // to map back to candidatePool indices

    var chunkResult = summariseChunk(chunk, c + 1, chunks.length, projectId, region);

    // FIX #6: Detect silent empty results after index filtering and count valid mappings
    var validMappings = 0;

    // Map chunk-local indices → global pool + attach real URLs
    for (var r = 0; r < chunkResult.length; r++) {
      var item = chunkResult[r];
      var rawIndex = parseInt(item.index, 10);
      // FIX: Guard against NaN from parseInt
      if (isNaN(rawIndex)) {
        Logger.log('Chunk ' + (c+1) + ': NaN index for item "' + (item.title || 'unknown') + '", skipping');
        continue;
      }
      var localIdx = rawIndex - 1; // 0-based within chunk
      if (localIdx < 0 || localIdx >= chunk.length) {
        Logger.log('Chunk ' + (c+1) + ': out-of-range index ' + item.index + ' (chunk size: ' + chunk.length + '), skipping');
        continue;
      }
      var original = chunk[localIdx];
      allResults.push({
        tier:           (item.tier || 'skip').toLowerCase(),
        title:          sanitise(item.title  || original.title),
        source:         sanitise(item.source || original.source),
        url:            original.url,   // ALWAYS from original — never trust model output for URLs
        summary:        sanitise(item.summary        || ''),
        why_it_matters: sanitise(item.why_it_matters || ''),
        significance:   sanitise(item.significance   || ''),
        score:          original.score,
      });
      validMappings++;
    }

    // FIX #6: If model returned items but none mapped successfully, inject fallback
    if (validMappings === 0 && chunk.length > 0) {
      Logger.log('Chunk ' + (c+1) + ': ZERO valid mappings from ' + chunkResult.length + ' items — injecting fallback');
      for (var fb = 0; fb < chunk.length; fb++) {
        allResults.push({
          tier:           chunk[fb].score >= 15 ? 'top' : 'notable',
          title:          chunk[fb].title,
          source:         chunk[fb].source,
          url:            chunk[fb].url,
          summary:        chunk[fb].desc ? chunk[fb].desc.slice(0, 200) : '',
          why_it_matters: '',
          significance:   '',
          score:          chunk[fb].score,
        });
      }
    }

    Logger.log('Chunk ' + (c+1) + '/' + chunks.length + ' processed: ' + validMappings + ' valid mappings from ' + chunkResult.length + ' items');
    if (c < chunks.length - 1) Utilities.sleep(1500); // small pause between chunks
  }

  // ── Global deduplication by normalised title ───────────────
  var seenTitles = {};
  var dedupedResults = [];
  for (var i = 0; i < allResults.length; i++) {
    var normTitle = allResults[i].title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 80);
    if (normTitle.length < 3) continue; // FIX: skip entries with empty/trivial titles
    if (!seenTitles[normTitle] && allResults[i].tier !== 'skip') {
      seenTitles[normTitle] = true;
      dedupedResults.push(allResults[i]);
    }
  }
  Logger.log('After global dedup: ' + dedupedResults.length + ' unique articles');

  // ── Sort by tier priority, then score ─────────────────────
  var tierPriority = { 'breakthrough': 0, 'top': 1, 'notable': 2 };
  dedupedResults.sort(function (a, b) {
    var ta = tierPriority[a.tier] !== undefined ? tierPriority[a.tier] : 3;
    var tb = tierPriority[b.tier] !== undefined ? tierPriority[b.tier] : 3;
    if (ta !== tb) return ta - tb;
    return b.score - a.score;
  });

  // ── Enforce section caps with strict cross-section uniqueness ─
  var usedTitles  = {};
  var breakthroughs  = [];
  var topArticles    = [];
  var notableArticles= [];

  function markUsed(item) {
    var k = item.title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 80);
    usedTitles[k] = true;
  }
  function isUsed(item) {
    var k = item.title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 80);
    return !!usedTitles[k];
  }

  // Pass 1: fill breakthroughs (tier = "breakthrough")
  for (var b = 0; b < dedupedResults.length && breakthroughs.length < MAX_BREAKTHROUGHS; b++) {
    if (dedupedResults[b].tier === 'breakthrough' && !isUsed(dedupedResults[b])) {
      breakthroughs.push(dedupedResults[b]);
      markUsed(dedupedResults[b]);
    }
  }

  // Pass 2: fill top_articles (tier = "top", or overflow breakthroughs if cap full)
  for (var t = 0; t < dedupedResults.length && topArticles.length < MAX_TOP_ARTICLES; t++) {
    if (dedupedResults[t].tier === 'top' && !isUsed(dedupedResults[t])) {
      topArticles.push(dedupedResults[t]);
      markUsed(dedupedResults[t]);
    }
  }
  // If top_articles is still underfull, backfill from unassigned high-scorers
  for (var bf = 0; bf < dedupedResults.length && topArticles.length < MAX_TOP_ARTICLES; bf++) {
    if (!isUsed(dedupedResults[bf]) && dedupedResults[bf].tier !== 'notable') {
      topArticles.push(dedupedResults[bf]);
      markUsed(dedupedResults[bf]);
    }
  }

  // Pass 3: notables — everything remaining that has a URL (title-only section)
  for (var n = 0; n < dedupedResults.length; n++) {
    if (!isUsed(dedupedResults[n]) && dedupedResults[n].url) {
      notableArticles.push(dedupedResults[n]);
    }
  }
  // Also add any high-scorers that scored well locally but were capped out
  for (var nc = 0; nc < candidatePool.length; nc++) {
    var cp = candidatePool[nc];
    if (!cp.url) continue;
    var k = cp.title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 80);
    if (!usedTitles[k]) {
      notableArticles.push({ title: cp.title, url: cp.url, source: cp.source, score: cp.score });
      usedTitles[k] = true;
    }
  }

  Logger.log('Final: ' + breakthroughs.length + ' breakthroughs, ' +
             topArticles.length + ' top articles, ' +
             notableArticles.length + ' notable articles');

  return {
    date:             today,
    breakthroughs:    breakthroughs,
    top_articles:     topArticles,
    notable_articles: notableArticles,
  };
}

// ── Summarise a single chunk with retry + fallback ──────────────
function summariseChunk(chunk, chunkNum, totalChunks, projectId, region) {
  var list = chunk.map(function (a, i) {
    return (i + 1) + '. TITLE: '   + sanitise(a.title) +
           '\n   SOURCE: '          + sanitise(a.source) +
           '\n   SCORE: '           + a.score +
           '\n   EXCERPT: '         + sanitise(a.desc).slice(0, 280);
  }).join('\n\n');

  var prompt =
    'You are a senior AI/ML research journalist. Chunk ' + chunkNum + ' of ' + totalChunks + '.\n' +
    'Classify and summarise each of the ' + chunk.length + ' articles below.\n\n' +
    'For EACH article assign a tier:\n' +
    '  "breakthrough" — new model release, landmark research paper, SOTA benchmark, major lab announcement\n' +
    '  "top"          — important AI/ML news, notable technique, significant industry move\n' +
    '  "notable"      — relevant but lower importance; will appear as title-only\n' +
    '  "skip"         — off-topic, duplicate concept, low value\n\n' +
    'Rules:\n' +
    '- index = the article number in this chunk (1-based, must be an integer from 1 to ' + chunk.length + ')\n' +
    '- For breakthrough and top: write sharp summary (1-2 sentences, cite model name/benchmark if present)\n' +
    '- why_it_matters: 1 sentence max, why this matters to AI/ML practitioners\n' +
    '- significance (breakthroughs only): 1 sentence on why this is landmark\n' +
    '- For notable and skip: summary, why_it_matters, significance may be empty strings\n' +
    '- Do NOT include URLs in any field\n' +
    '- All text must be plain ASCII/Unicode, no control characters\n\n' +
    'ARTICLES:\n' + list + '\n\n' +
    'Return a JSON object with key "items" containing an array of objects, one per article.\n' +
    'Each object must have: index (integer), tier (string), title (string), source (string), ' +
    'summary (string), why_it_matters (string), significance (string).';

  // Attempt with Flash, retry on failure
  for (var attempt = 1; attempt <= MAX_RETRIES; attempt++) {
    try {
      var raw    = callGemini('gemini-2.5-flash', prompt, 12000, projectId, region, CHUNK_SCHEMA);
      var parsed = extractJSON(raw);
      var items  = parsed.items || [];

      if (items.length === 0) throw new Error('Empty items array from Flash chunk ' + chunkNum);

      // FIX: Validate that at least some items have valid indices within range
      var validCount = 0;
      for (var v = 0; v < items.length; v++) {
        var idx = parseInt(items[v].index, 10);
        if (!isNaN(idx) && idx >= 1 && idx <= chunk.length) validCount++;
      }
      if (validCount === 0) {
        throw new Error('Chunk ' + chunkNum + ': ' + items.length + ' items but NONE have valid indices (1-' + chunk.length + ')');
      }

      Logger.log('Chunk ' + chunkNum + ' Flash OK: ' + items.length + ' items, ' + validCount + ' valid indices (attempt ' + attempt + ')');
      return items;
    } catch (e) {
      Logger.log('Chunk ' + chunkNum + ' attempt ' + attempt + ' failed: ' + e.message);
      if (attempt < MAX_RETRIES) Utilities.sleep(RETRY_DELAY_MS);
    }
  }

  // ── Hard fallback: return chunk articles as "top" with empty summaries ──
  Logger.log('Chunk ' + chunkNum + ' ALL ATTEMPTS FAILED — using fallback passthrough');
  return chunk.map(function (a, i) {
    return {
      index:          i + 1,
      tier:           a.score >= 15 ? 'top' : 'notable',
      title:          a.title,
      source:         a.source,
      summary:        a.desc ? a.desc.slice(0, 200) : '',
      why_it_matters: '',
      significance:   '',
    };
  });
}

// ── Trigger setup: 7 AM + 5 PM daily ───────────────────────────
function setupTrigger() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) ScriptApp.deleteTrigger(triggers[i]);

  var tz = safeTimezone(); // FIX: Use safe timezone helper

  ScriptApp.newTrigger('sendDailyDigest')
    .timeBased().atHour(7).everyDays(1)
    .inTimezone(tz).create();

  ScriptApp.newTrigger('sendDailyDigest')
    .timeBased().atHour(17).everyDays(1)
    .inTimezone(tz).create();

  Logger.log('✅ Triggers set: 7 AM and 5 PM in ' + tz);
}

function testRun() { sendDailyDigest(); }

// ── HTML email builder ──────────────────────────────────────────
function buildEmailHTML(digest, edition) {
  // FIX: Defensive defaults for all arrays
  var arts      = (digest && digest.top_articles)      ? digest.top_articles      : [];
  var bts       = (digest && digest.breakthroughs)     ? digest.breakthroughs     : [];
  var notables  = (digest && digest.notable_articles)  ? digest.notable_articles  : [];

  var G    = '#00e5a0';
  var GOLD = '#f5c542';
  var DIM  = '#888';

  function esc(s) {
    return String(s || '')
      .replace(/&/g,  '&amp;')
      .replace(/</g,  '&lt;')
      .replace(/>/g,  '&gt;')
      .replace(/"/g,  '&quot;');
  }
  function pad2(n) { return String(n).length < 2 ? '0' + n : String(n); }

  // ── Breakthroughs section ───────────────────────────────────
  var btHTML = '';
  if (bts.length) {
    var btItems = bts.map(function (b, i) {
      // FIX: Guard against null/undefined fields in each breakthrough
      var bTitle  = esc(b.title  || 'Untitled');
      var bSource = esc(b.source || 'Unknown');
      var bUrl    = b.url || '';
      var bSummary      = b.summary        || '';
      var bSignificance = b.significance   || '';

      return '<div style="background:#0f1a14;border-left:4px solid ' + GOLD + ';padding:18px 20px;border-radius:6px;margin-bottom:14px;">' +
        '<div style="display:flex;align-items:flex-start;gap:12px;">' +
        '<span style="font-family:\'Courier New\',monospace;font-size:22px;font-weight:900;color:' + GOLD + ';min-width:32px;line-height:1.1;flex-shrink:0;">' + pad2(i + 1) + '</span>' +
        '<div style="flex:1;">' +
        '<div style="font-size:15px;font-weight:700;color:#fffbe6;margin-bottom:5px;line-height:1.4;">' +
          (bUrl ? '<a href="' + esc(bUrl) + '" style="color:#fffbe6;text-decoration:none;">' + bTitle + '</a>' : bTitle) +
        '</div>' +
        '<div style="font-size:10px;color:' + GOLD + ';text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px;font-family:\'Courier New\',monospace;">' + bSource + '</div>' +
        (bSummary ? '<div style="font-size:13px;color:#ccc;line-height:1.75;margin-bottom:6px;">' + esc(bSummary) + '</div>' : '') +
        (bSignificance ? '<div style="font-size:12px;color:' + GOLD + ';font-style:italic;border-top:1px solid #2a2a1a;padding-top:6px;margin-top:4px;">⚡ ' + esc(bSignificance) + '</div>' : '') +
        (bUrl ? '<div style="margin-top:10px;"><a href="' + esc(bUrl) + '" style="font-family:\'Courier New\',monospace;font-size:10px;color:#666;text-decoration:none;letter-spacing:0.5px;">↗ READ MORE</a></div>' : '') +
        '</div></div></div>';
    });
    btHTML = '<div style="padding:28px 32px;border-bottom:1px solid #1a1a1a;">' +
      '<div style="font-family:\'Courier New\',monospace;font-size:10px;color:' + GOLD + ';letter-spacing:5px;text-transform:uppercase;margin-bottom:6px;">// major breakthroughs</div>' +
      '<div style="font-size:11px;color:#333;margin-bottom:20px;font-family:\'Courier New\',monospace;">' + bts.length + ' landmark events this period</div>' +
      btItems.join('') +
      '</div>';
  }

  // ── Top articles section ────────────────────────────────────
  var artHTML = '';
  if (arts.length) {
    var artItems = arts.map(function (a, i) {
      // FIX: Guard against null/undefined fields
      var aTitle  = esc(a.title  || 'Untitled');
      var aSource = esc(a.source || 'Unknown');
      var aUrl    = a.url || '';
      var aSummary       = a.summary        || '';
      var aWhyItMatters  = a.why_it_matters || '';

      return '<div style="display:flex;gap:18px;padding:18px 0;border-bottom:1px solid #151515;">' +
        '<span style="font-family:\'Courier New\',monospace;font-size:26px;font-weight:900;color:' + G + ';min-width:40px;line-height:1;flex-shrink:0;padding-top:2px;">' + pad2(i + 1) + '</span>' +
        '<div style="flex:1;">' +
        '<div style="font-size:14px;font-weight:700;color:#f0f0f0;margin-bottom:5px;line-height:1.4;">' +
          (aUrl ? '<a href="' + esc(aUrl) + '" style="color:#f0f0f0;text-decoration:none;">' + aTitle + '</a>' : aTitle) +
        '</div>' +
        '<div style="font-size:10px;color:#444;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px;font-family:\'Courier New\',monospace;">' + aSource + '</div>' +
        (aSummary ? '<div style="font-size:13px;color:#999;line-height:1.75;margin-bottom:6px;">' + esc(aSummary) + '</div>' : '') +
        (aWhyItMatters ? '<div style="font-size:12px;color:' + G + ';border-top:1px solid #1a1a1a;padding-top:6px;margin-top:4px;">→ ' + esc(aWhyItMatters) + '</div>' : '') +
        (aUrl ? '<div style="margin-top:8px;"><a href="' + esc(aUrl) + '" style="font-family:\'Courier New\',monospace;font-size:10px;color:#444;text-decoration:none;letter-spacing:0.5px;">↗ READ MORE</a></div>' : '') +
        '</div></div>';
    });
    artHTML = '<div style="padding:28px 32px;border-bottom:1px solid #1a1a1a;">' +
      '<div style="font-family:\'Courier New\',monospace;font-size:10px;color:' + G + ';letter-spacing:5px;text-transform:uppercase;margin-bottom:6px;">// top articles</div>' +
      '<div style="font-size:11px;color:#333;margin-bottom:20px;font-family:\'Courier New\',monospace;">' + arts.length + ' curated stories</div>' +
      artItems.join('') +
      '</div>';
  }

  // ── Notable articles section (title + link only) ────────────
  var notableHTML = '';
  if (notables.length) {
    var notableItems = notables.map(function (n) {
      // FIX: Guard against null/undefined fields
      var nTitle  = esc(n.title  || 'Untitled');
      var nSource = esc(n.source || 'Unknown');
      var nUrl    = n.url || '';

      return '<div style="padding:8px 0;border-bottom:1px solid #111;display:flex;align-items:baseline;gap:10px;">' +
        '<span style="font-family:\'Courier New\',monospace;font-size:10px;color:#333;flex-shrink:0;">›</span>' +
        '<div>' +
        (nUrl
          ? '<a href="' + esc(nUrl) + '" style="font-size:12px;color:#777;text-decoration:none;line-height:1.5;">' + nTitle + '</a>'
          : '<span style="font-size:12px;color:#555;line-height:1.5;">' + nTitle + '</span>') +
        '<span style="font-family:\'Courier New\',monospace;font-size:9px;color:#333;margin-left:8px;text-transform:uppercase;letter-spacing:1px;">' + nSource + '</span>' +
        '</div></div>';
    });
    notableHTML = '<div style="padding:24px 32px;border-bottom:1px solid #1a1a1a;">' +
      '<div style="font-family:\'Courier New\',monospace;font-size:10px;color:#555;letter-spacing:5px;text-transform:uppercase;margin-bottom:6px;">// notable articles</div>' +
      '<div style="font-size:11px;color:#333;margin-bottom:16px;font-family:\'Courier New\',monospace;">' + notables.length + ' additional signals</div>' +
      notableItems.join('') +
      '</div>';
  }

  // ── Stats bar + Live Cost Tracking ────────────────────────────
  // Current Vertex AI Gemini 2.5 Flash rates: $0.075 per 1M input / $0.30 per 1M output
  var rateIn = 0.075 / 1000000;
  var rateOut = 0.30 / 1000000;
  
  var totalTokens = TOKEN_TRACKER['gemini-2.5-flash-lite'].in + TOKEN_TRACKER['gemini-2.5-flash-lite'].out + 
                    TOKEN_TRACKER['gemini-2.5-flash'].in + TOKEN_TRACKER['gemini-2.5-flash'].out;
                    
  var runCost = (TOKEN_TRACKER['gemini-2.5-flash-lite'].in * rateIn) + 
                (TOKEN_TRACKER['gemini-2.5-flash-lite'].out * rateOut) +
                (TOKEN_TRACKER['gemini-2.5-flash'].in * rateIn) + 
                (TOKEN_TRACKER['gemini-2.5-flash'].out * rateOut);

  var statsHTML = '<div style="padding:14px 32px;background:#080808;border-top:1px solid #111;">' +
    '<div style="font-family:\'Courier New\',monospace;font-size:10px;color:#333;letter-spacing:2px;text-align:center;">' +
    'AI DIGEST · ' + RSS_FEEDS.length + ' SOURCES · ' +
    bts.length + ' BREAKTHROUGHS · ' + arts.length + ' TOP · ' + notables.length + ' NOTABLE<br>' +
    '<span style="color:#555;font-size:9px;">TOKENS USED: ' + totalTokens.toLocaleString() + ' · RUN COST: $' + runCost.toFixed(5) + '</span>' +
    '</div></div>';


  return '<!DOCTYPE html><html><head>' +
    '<meta charset="UTF-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1">' +
    '</head>' +
    '<body style="margin:0;padding:0;background:#080808;font-family:Georgia,\'Times New Roman\',serif;">' +
    '<div style="max-width:680px;margin:0 auto;background:#0d0d0d;">' +

    // ── Header ─────────────────────────────────────────────
    '<div style="padding:40px 32px 30px;border-bottom:1px solid #1a1a1a;">' +
    '<div style="font-family:\'Courier New\',monospace;font-size:9px;color:' + G + ';letter-spacing:6px;text-transform:uppercase;margin-bottom:12px;">// intelligence · ' + RSS_FEEDS.length + ' sources · gemini vertex ai</div>' +
    '<div style="font-size:38px;font-weight:900;color:#f5f5f5;line-height:1;letter-spacing:-1px;">AI &amp; Data Science</div>' +
    '<div style="font-size:38px;font-weight:900;line-height:1.2;letter-spacing:-1px;">' +
    '<span style="color:' + G + ';">' + esc(edition || 'Daily Edition') + '</span>' +
    '<span style="color:' + G + ';opacity:0.5;">_</span>' +
    '</div>' +
    '<div style="margin-top:16px;display:flex;gap:20px;flex-wrap:wrap;">' +
    '<span style="font-family:\'Courier New\',monospace;font-size:10px;color:#222;">' + esc(digest.date || '') + '</span>' +
    '<span style="font-family:\'Courier New\',monospace;font-size:10px;color:' + GOLD + ';">⚡ ' + bts.length + ' breakthroughs</span>' +
    '<span style="font-family:\'Courier New\',monospace;font-size:10px;color:' + G + ';">↗ ' + arts.length + ' top stories</span>' +
    '<span style="font-family:\'Courier New\',monospace;font-size:10px;color:#333;">+ ' + notables.length + ' notable</span>' +
    '</div>' +
    '</div>' +

    btHTML +
    artHTML +
    notableHTML +
    statsHTML +

    '</div></body></html>';
}

function runDiagnostic() {
  var feedUrl = 'https://techcrunch.com/category/artificial-intelligence/feed/';
  Logger.log("Fetching: " + feedUrl);
  var resp = UrlFetchApp.fetch(feedUrl, {muteHttpExceptions: true});
  var rawXml = resp.getContentText().replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, '');
  
  try {
    var root = XmlService.parse(rawXml).getRootElement();
    var items = root.getChild('channel') ? root.getChild('channel').getChildren('item') : [];
    
    Logger.log("Found " + items.length + " items in XML.");
    
    if(items.length > 0) {
       var el = items[0];
       Logger.log("--- First Article Parsing Test ---");
       Logger.log("Title extracted: " + xmlText(el, 'title'));
       Logger.log("URL extracted: " + xmlLink(el));
       Logger.log("Date MS: " + xmlDate(el));
    }
  } catch (e) {
    Logger.log("XML Parsing crashed: " + e.message);
  }
}
