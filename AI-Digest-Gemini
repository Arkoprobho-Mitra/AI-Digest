// ── Shared Vertex AI caller (Gemini) ────────────────────────────
function callGemini(model, prompt, maxTokens, projectId, region, schemas) {
  var endpoint = 'https://' + region + '-aiplatform.googleapis.com/v1/projects/' +
                 projectId + '/locations/' + region +
                 '/publishers/google/models/' + model + ':generateContent';

  var resp = UrlFetchApp.fetch(endpoint, {
    method: 'post',
    contentType: 'application/json',
    headers: { 'Authorization': 'Bearer ' + ScriptApp.getOAuthToken() },
    payload: JSON.stringify({
      contents: [{ role: 'user', parts: [{ text: prompt }] }],
      generationConfig: {
        temperature: 0.1,
        maxOutputTokens: maxTokens,
        responseMimeType: 'application/json',
        responseSchema: schemas[model] || undefined,
      },
    }),
    muteHttpExceptions: true,
  });

  var data = JSON.parse(resp.getContentText());
  if (data.error) throw new Error('Vertex (' + model + '): ' + data.error.message);

  // Safely extract text regardless of candidate structure
  var candidates = data.candidates || [];
  if (!candidates.length) throw new Error('No candidates returned from ' + model);
  var parts = (candidates[0].content || {}).parts || [];
  if (!parts.length) throw new Error('No parts in candidate from ' + model);

  var raw = parts[0].text || '';
  // Strip markdown fences Gemini occasionally wraps JSON in
  raw = raw.replace(/^```json\s*/i, '').replace(/\s*```$/i, '').trim();
  return raw;
}

// ── Robust JSON extractor with sanitisation ─────────────────────
// Handles: leading/trailing text, Gemini "thinking" preamble,
// invalid escape sequences, and truncated responses.
function extractJSON(raw) {
  // With responseSchema enforced, this should always be clean JSON.
  // Minimal cleanup kept as a safety net only.
  try {
    return JSON.parse(raw);
  } catch (e) {
    // Strip markdown fences just in case
    var clean = raw.replace(/^```json\s*/i, '').replace(/\s*```$/i, '').trim();
    try {
      return JSON.parse(clean);
    } catch (e2) {
      Logger.log('Schema-enforced parse still failed: ' + e2.message);
      Logger.log('Raw: ' + raw.slice(0, 500));
      throw new Error('JSON parse failed: ' + e2.message);
    }
  }
}
// ── Stage 1: Flash-Lite — dedupe & filter ($0.10/M tokens) ─────
function filterWithFlashLite(articles, projectId, region) {
  var list = articles.map(function (a, i) {
    // Sanitise title + excerpt so no control chars reach the prompt
    var t = sanitise(a.title);
    var d = sanitise(a.desc).slice(0, 120);
    return (i + 1) + '. [score:' + a.score + '] ' + t +
           ' | ' + a.source + ' | ' + d;
  }).join('\n');

  var prompt =
    'You are an AI news editor. ' + articles.length + ' pre-scored articles below.\n\n' +
    'Select the 20 best articles:\n' +
    '- Remove duplicates (same story from multiple sources, keep highest score)\n' +
    '- Remove off-topic articles (not genuinely about AI/ML/data science)\n' +
    '- Deprioritise: opinion pieces, tutorials, listicles\n' +
    '- Prioritise: model releases, research papers, lab announcements, breakthroughs\n\n' +
    'ARTICLES:\n' + list + '\n\n' +
    'Return a JSON object with a single key "selected" containing an array of ' +
    'exactly 15 integers (1-indexed article numbers). Example: {"selected":[1,4,7,9,11,12,13,15,17,19,21,23,25,27,30]}';

  try {
    var raw    = callGemini('gemini-2.5-flash-lite', prompt, 10000, projectId, region, FILTER_SCHEMA);
    var parsed = extractJSON(raw);
    var sel    = (parsed.selected || [])
      .filter(function (n) { return n >= 1 && n <= articles.length; })
      .map(function (n) { return articles[n - 1]; });
    if (sel.length >= 10) {
      Logger.log('Flash-Lite selected: ' + sel.length + ' articles');
      return sel;
    }
    Logger.log('Flash-Lite returned too few (' + sel.length + ') — using top 15');
  } catch (e) {
    Logger.log('Flash-Lite error: ' + e.message + ' — using top 15 by score');
  }
  return articles.slice(0, 20);
}

// ── Stage 2: Flash — deep summarisation ($0.30/M tokens) ───────
function summariseWithFlash(articles, projectId, region) {
  var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'MMMM d, yyyy');

  // Sanitise every field before it enters the prompt
  var list = articles.map(function (a, i) {
    return (i + 1) + '. TITLE: '   + sanitise(a.title) +
           '\n   SOURCE: '          + sanitise(a.source) +
           '\n   LINK: '            + sanitise(a.url) +   // renamed URL→LINK, less ambiguous
           '\n   EXCERPT: '         + sanitise(a.desc).slice(0, 800);
  }).join('\n\n');

  // Keep the JSON schema description in plain English — do NOT inline
  // the date or any variable inside a JSON template string, as that
  // is what caused the original position-1504 parse error.
var prompt =
    'You are a senior AI/ML research journalist. Today is ' + today + '.\n' +
    'These ' + articles.length + ' articles are today\'s top AI/data science stories.\n\n' +
    'TASKS:\n' +
    '1. Pick the TOP 15 most important articles and rank them 1-15.\n' +
    '2. Identify up to 5 MAJOR BREAKTHROUGHS separately (new model releases, landmark papers).\n' +
    '3. Write sharp summaries: name the model, cite benchmark numbers, state the key claim.\n\n' +
    'ARTICLES:\n' + list + '\n\n' +
    'OUTPUT FORMAT — return a single valid JSON object with exactly these keys:\n' +
    '  date          : string, today\'s date\n' +
    '  breakthroughs : array of up to 5 objects, each with keys: title, source, summary, significance, index\n' +
    '  top_articles  : array of exactly 15 objects, each with keys: rank, index, title, source, summary, why_it_matters\n\n' +
    'Rules:\n' +
    '- top_articles must contain EXACTLY 15 items — no more, no less\n' +
    '- index must be the original INDEX number from the article list above — this is how URLs get attached\n' +
    '- breakthroughs and top_articles are mutually exclusive — the same story must not appear in both\n' +
    '- Do NOT include a url field anywhere — URLs are handled separately via index\n' +
    '- All string values must use plain ASCII or common Unicode only — no control characters\n' +
    '- Return ONLY the JSON object, no markdown fences, no explanation before or after';


  // Attempt summarisation with one automatic retry on parse failure
  var raw, digest;
  for (var attempt = 1; attempt <= 2; attempt++) {
    try {
      raw    = callGemini('gemini-2.5-flash', prompt, 8192, projectId, region, DIGEST_SCHEMA);
      digest = extractJSON(raw);
      // Validate minimal structure
      if (!digest.top_articles || !Array.isArray(digest.top_articles)) {
        throw new Error('top_articles missing or not an array');
      }
      if (digest.top_articles.length < 10) {
        throw new Error('top_articles has only ' + digest.top_articles.length + ' items, expected 15');
      }
      if (!digest.date) digest.date = today;
      if (!digest.breakthroughs) digest.breakthroughs = [];

      // Inject real URLs from original articles using the index Flash returned.
      // This is 100% reliable — we never trust Flash to carry URLs through.
      digest.top_articles = digest.top_articles.map(function (a) {
        var idx = parseInt(a.index, 10);
        if (idx >= 1 && idx <= articles.length) {
          a.url = articles[idx - 1].url;
        }
        return a;
      });

      // Same for breakthroughs — match by title substring against originals
      digest.breakthroughs = digest.breakthroughs.map(function (b) {
        if (b.url) return b; // already has one
        var btTitle = (b.title || '').toLowerCase();
        for (var x = 0; x < articles.length; x++) {
          if (articles[x].title.toLowerCase().indexOf(btTitle.slice(0, 40)) !== -1) {
            b.url = articles[x].url;
            break;
          }
        }
        return b;
      });

      Logger.log('Flash summarised: ' + digest.top_articles.length +
                 ' articles, ' + digest.breakthroughs.length + ' breakthroughs');
      return digest;
    } catch (e) {
      Logger.log('summariseWithFlash attempt ' + attempt + ' failed: ' + e.message);
      if (attempt === 2) throw new Error('Flash summarisation failed after 2 attempts: ' + e.message);
      Utilities.sleep(3000); // wait 3s before retry
    }
  }
}

// ── Trigger setup: 6 AM + 4 PM daily ───────────────────────────
function setupTrigger() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) ScriptApp.deleteTrigger(triggers[i]);

  ScriptApp.newTrigger('sendDailyDigest')
    .timeBased().atHour(6).everyDays(1)
    .inTimezone(Session.getScriptTimeZone()).create();

  ScriptApp.newTrigger('sendDailyDigest')
    .timeBased().atHour(16).everyDays(1)
    .inTimezone(Session.getScriptTimeZone()).create();

  Logger.log('✅ Triggers set: 6 AM and 4 PM in ' + Session.getScriptTimeZone());
}

