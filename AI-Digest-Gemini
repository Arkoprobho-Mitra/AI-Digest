// ── Score a single article ──────────────────────────────────────
function scoreArticle(article) {
  var body = (article.title + ' ' + article.desc).toLowerCase();
  var score = 0, i;
  for (i = 0; i < KEYWORDS_W3.length; i++) {
    if (body.indexOf(KEYWORDS_W3[i]) !== -1) score += 3;
  }
  for (i = 0; i < KEYWORDS_W2.length; i++) {
    if (body.indexOf(KEYWORDS_W2[i]) !== -1) score += 2;
  }
  for (i = 0; i < KEYWORDS_W1.length; i++) {
    if (body.indexOf(KEYWORDS_W1[i]) !== -1) score += 1;
  }
  var LAB_SOURCES = ['nvidia','openai','anthropic','google','meta',
                     'microsoft','huggingface','deepmind','amazon'];
  for (i = 0; i < LAB_SOURCES.length; i++) {
    if (article.source.indexOf(LAB_SOURCES[i]) !== -1) { score += 2; break; }
  }
  if (article.source.indexOf('arxiv') !== -1) score += 1;
  article.score = score;
  return article;
}
