// ── Main entry point ────────────────────────────────────────────
function sendDailyDigest() {
  var props     = PropertiesService.getScriptProperties();
  var projectId = props.getProperty('GCP_PROJECT_ID');
  var region    = props.getProperty('VERTEX_REGION') || 'us-central1';

  if (!projectId) {
    Logger.log('FATAL: GCP_PROJECT_ID not set in Script Properties.');
    throw new Error('GCP_PROJECT_ID not set in Script Properties.');
  }

  var nowMs      = new Date().getTime();
  var lastRunStr = props.getProperty('LAST_RUN_TIME');
  var lastRunMs  = lastRunStr
    ? parseInt(lastRunStr, 10)
    : nowMs - (14 * 60 * 60 * 1000);

  Logger.log('=== Digest run started at ' + new Date(nowMs).toLocaleString() + ' ===');
  Logger.log('Fetching articles after: ' + new Date(lastRunMs).toLocaleString());

  // ── Step 1: Fetch RSS ───────────────────────────────────────
  var articles = [];
  try {
    articles = fetchRSSArticles(lastRunMs);
  } catch (e) {
    Logger.log('FATAL: RSS fetch failed: ' + e.message);
    throw e;
  }
  Logger.log('Raw articles in window: ' + articles.length);

  if (articles.length === 0) {
    Logger.log('No new articles — skipping email.');
    props.setProperty('LAST_RUN_TIME', nowMs.toString());
    return;
  }

  // ── Step 2: Local weighted scoring ─────────────────────────
  articles = articles.map(scoreArticle);
  articles.sort(function (a, b) { return b.score - a.score; });
  Logger.log('Top local score: ' + articles[0].score + ' — ' + articles[0].title);

  // ── Step 3: Flash-Lite deduplication & selection ───────────
  var candidatePool;
  try {
    var top60 = articles.slice(0, 60);
    Logger.log('Stage 1 (Flash-Lite): filtering ' + top60.length + ' → 45...');
    candidatePool = filterWithFlashLite(top60, projectId, region);
    Logger.log('Stage 1 done: ' + candidatePool.length + ' candidates');
  } catch (e) {
    Logger.log('Stage 1 failed, falling back to top-45 by score: ' + e.message);
    candidatePool = articles.slice(0, 45);
  }

  // ── Step 4: Flash chunked summarisation ────────────────────
  Logger.log('Stage 2 (Flash): chunked summarisation of ' + candidatePool.length + ' articles...');
  var digest = summariseInChunks(candidatePool, projectId, region);

  // ── Step 5: Build & send email ─────────────────────────────
  var hour    = new Date().getHours();
  var edition = hour < 12 ? '🌅 Morning Edition' : '🌇 Evening Edition';
  var subject = '[AI Digest] ' + digest.date + ' — ' + edition +
                ' (' + digest.breakthroughs.length + ' breakthroughs, ' +
                digest.top_articles.length + ' articles)';
  var email = props.getProperty('RECIPIENT_EMAIL');

  if (!email) {
    Logger.log('FATAL: RECIPIENT_EMAIL not set in Script Properties.');
    throw new Error('RECIPIENT_EMAIL not set in Script Properties.');
  }
  try {
    GmailApp.sendEmail(email, subject,
      'Your mail client does not support HTML.',
      { htmlBody: buildEmailHTML(digest, edition), name: 'AI Daily Digest' }
    );
    Logger.log('✅ Digest sent to ' + email);
  } catch (e) {
    Logger.log('FATAL: Email send failed: ' + e.message);
    throw e;
  }

  props.setProperty('LAST_RUN_TIME', nowMs.toString());
  Logger.log('=== Digest run complete ===');
}

// ── Fetch & filter articles from RSS ───────────────────────────
function fetchRSSArticles(lastRunMs) {
  var allKws   = KEYWORDS_W3.concat(KEYWORDS_W2).concat(KEYWORDS_W1);
  var articles = [], seen = {};
  var feedErrors = 0;

  for (var f = 0; f < RSS_FEEDS.length; f++) {
    var feedUrl = RSS_FEEDS[f];
    try {
      var resp = UrlFetchApp.fetch(feedUrl, {
        muteHttpExceptions: true,
        followRedirects: true,
        headers: { 'User-Agent': 'Mozilla/5.0 (compatible; GAS-Digest/1.0)' },
      });

      if (resp.getResponseCode() !== 200) {
        Logger.log('Feed HTTP ' + resp.getResponseCode() + ': ' + feedUrl);
        feedErrors++;
        continue;
      }

      var rawXml = resp.getContentText();
      // Sanitize XML before parsing to avoid control character crashes
      rawXml = rawXml.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, '');

      var root, channel, items;
      try {
        root    = XmlService.parse(rawXml).getRootElement();
        channel = root.getChild('channel');

        // FIX #1: Robust Atom + RSS item detection
        // Try RSS <channel><item> first
        if (channel) {
          items = channel.getChildren('item');
        }

        // If no RSS items found, try Atom <entry> at root level
        // Check multiple common Atom namespace patterns
        if (!items || items.length === 0) {
          var atomNs = XmlService.getNamespace('http://www.w3.org/2005/Atom');
          items = root.getChildren('entry', atomNs);

          // Some feeds use default namespace without explicit Atom NS
          if (!items || items.length === 0) {
            items = root.getChildren('entry');
          }

          // Some Atom feeds nest entries inside a <feed> child (rare but exists)
          if (!items || items.length === 0) {
            var feedChild = root.getChild('feed', atomNs) || root.getChild('feed');
            if (feedChild) {
              items = feedChild.getChildren('entry', atomNs);
              if (!items || items.length === 0) {
                items = feedChild.getChildren('entry');
              }
            }
          }
        }

        // Final fallback: try RDF (RSS 1.0) which puts <item> at root level
        if (!items || items.length === 0) {
          var rdfNs = XmlService.getNamespace('http://purl.org/rss/1.0/');
          items = root.getChildren('item', rdfNs);
          if (!items || items.length === 0) {
            items = root.getChildren('item');
          }
        }

      } catch (parseErr) {
        Logger.log('XML parse error for ' + feedUrl + ': ' + parseErr.message);
        feedErrors++;
        continue;
      }

      if (!items || items.length === 0) continue;

      var isAiOnly = false;
      for (var a = 0; a < AI_ONLY_SOURCES.length; a++) {
        if (feedUrl.indexOf(AI_ONLY_SOURCES[a]) !== -1) { isAiOnly = true; break; }
      }

      var sourceName = feedUrl
        .replace(/https?:\/\/(www\.|feeds\.|feedburner\.|rss\.)?/, '')
        .split('/')[0];

      for (var i = 0; i < Math.min(items.length, 10); i++) {
        try {
          var title = xmlText(items[i], 'title');
          if (!title || title.trim().length < 5) continue;
          title = sanitise(title);

          var pubMs = xmlDate(items[i]);
          //if (pubMs && pubMs <= lastRunMs) continue;

          var key = title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 80);
          if (seen[key]) continue;

          var url  = xmlLink(items[i]);
          // Require a valid URL — articles without links are useless
          if (!url || url.indexOf('http') !== 0) continue;

          var descRaw = xmlText(items[i], 'description')
                     || xmlText(items[i], 'summary')
                     || xmlText(items[i], 'content')    // FIX: some Atom feeds use <content> not <summary>
                     || '';
          var desc = sanitise(
            descRaw
              .replace(/<[^>]*>/g, '')
              .replace(/&amp;/g,  '&')
              .replace(/&lt;/g,   '<')
              .replace(/&gt;/g,   '>')
              .replace(/&quot;/g, '"')
              .replace(/&#39;/g,  "'")
              .slice(0, 600)
          ).trim();

          if (!isAiOnly) {
            var body = (title + ' ' + desc).toLowerCase();
            var relevant = false;
            for (var k = 0; k < allKws.length; k++) {
              if (body.indexOf(allKws[k]) !== -1) { relevant = true; break; }
            }
            if (!relevant) continue;
          }

          seen[key] = true;
          articles.push({
            title:  title,
            url:    url,
            desc:   desc,
            source: sourceName,
            score:  0,
          });
        } catch (itemErr) {
          // Skip bad items silently
        }
      }
    } catch (feedErr) {
      Logger.log('Feed error (' + feedUrl + '): ' + feedErr.message);
      feedErrors++;
    }
  }

  Logger.log('Feed errors: ' + feedErrors + '/' + RSS_FEEDS.length);
  return articles;
}

// ── XML helpers ─────────────────────────────────────────────────
function xmlText(el, tag) {
  try {
    var c = el.getChild(tag);
    if (c) return c.getText() || c.getValue() || null;  // FIX: getValue() catches CDATA
    // Try Atom namespace
    var ns = XmlService.getNamespace('http://www.w3.org/2005/Atom');
    var ca = el.getChild(tag, ns);
    if (ca) return ca.getText() || ca.getValue() || null;
    // FIX: Try Dublin Core namespace (used by some RSS feeds for dc:title etc.)
    var dcNs = XmlService.getNamespace('dc', 'http://purl.org/dc/elements/1.1/');
    var dcChild = el.getChild(tag, dcNs);
    if (dcChild) return dcChild.getText() || null;
    return null;
  } catch (e) { return null; }
}

function xmlLink(el) {
  try {
    // 1. Try standard RSS <link> tags
    var links = el.getChildren('link');
    for (var i = 0; i < links.length; i++) {
      var text = (links[i].getText() || links[i].getValue() || '').trim();
      if (text.indexOf('http') === 0) return text;
      
      // 2. Try Atom-style href attribute on standard links
      var href = links[i].getAttributeValue('href');
      if (href && href.trim().indexOf('http') === 0) return href.trim();
    }

    // 3. Try Atom namespace <link> tags
    var atomNs = XmlService.getNamespace('http://www.w3.org/2005/Atom');
    var atomLinks = el.getChildren('link', atomNs);
    for (var j = 0; j < atomLinks.length; j++) {
      var aHref = atomLinks[j].getAttributeValue('href');
      if (aHref && aHref.trim().indexOf('http') === 0) return aHref.trim();
    }

    // 4. Fallback to <guid> if it is a permalink
    var guid = el.getChild('guid');
    if (guid) {
      var gText = (guid.getText() || guid.getValue() || '').trim();
      if (gText.indexOf('http') === 0) return gText;
    }

    // 5. Try Feedburner original links
    try {
      var fbNs = XmlService.getNamespace('feedburner', 'http://rssnamespace.org/feedburner/ext/1.0');
      var fbLink = el.getChild('origLink', fbNs);
      if (fbLink) {
        var fbText = (fbLink.getText() || fbLink.getValue() || '').trim();
        if (fbText.indexOf('http') === 0) return fbText;
      }
    } catch (e) {}

  } catch (e) {}
  return null;
}

// FIX #2: xmlDate now checks dc:date (Dublin Core) to prevent stale article leaks
function xmlDate(el) {
  try {
    var ns = XmlService.getNamespace('http://www.w3.org/2005/Atom');
    var dStr = xmlText(el, 'pubDate')
            || (el.getChild('updated',   ns) ? el.getChild('updated',   ns).getText() : null)
            || (el.getChild('published', ns) ? el.getChild('published', ns).getText() : null);

    // FIX: Check Dublin Core dc:date (used by many older/academic RSS feeds like some arxiv feeds)
    if (!dStr) {
      try {
        var dcNs = XmlService.getNamespace('dc', 'http://purl.org/dc/elements/1.1/');
        var dcDate = el.getChild('date', dcNs);
        if (dcDate) dStr = dcDate.getText();
      } catch (dcErr) { /* ignore */ }
    }

    // FIX: Also check <updated> and <published> without namespace (some feeds omit NS)
    if (!dStr) {
      var updatedNoNs = el.getChild('updated');
      if (updatedNoNs) dStr = updatedNoNs.getText();
    }
    if (!dStr) {
      var publishedNoNs = el.getChild('published');
      if (publishedNoNs) dStr = publishedNoNs.getText();
    }

    if (dStr) {
      var ms = new Date(dStr).getTime();
      if (!isNaN(ms)) return ms;

      // FIX: Handle ISO 8601 dates that Date() can't parse natively in GAS
      // e.g., "2025-03-27T10:30:00+05:30" — some engines choke on the offset
      try {
        var isoClean = dStr.replace(/([+-]\d{2}):(\d{2})$/, '$1$2'); // Remove colon in TZ offset
        ms = new Date(isoClean).getTime();
        if (!isNaN(ms)) return ms;
      } catch (isoErr) { /* ignore */ }
    }
  } catch (e) {}
  return null;
}

// ── Text sanitiser ──────────────────────────────────────────────
// FIX #3: Preserves emoji (surrogate pairs) and full Unicode correctly
function sanitise(text) {
  return String(text || '')
    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '')  // Strip control chars (keep \t \n \r for now)
    .replace(/\r\n|\r/g, ' ')
    .replace(/\n/g, ' ')
    .replace(/\t/g, ' ')
    .replace(/\s{2,}/g, ' ')
    // FIX: Only strip isolated surrogates (broken pairs), not valid surrogate pairs (emoji)
    // Previous regex [^\x20-\x7E\u00A0-\uFFFF] would kill all surrogates including valid emoji
    .replace(/(?:[\uD800-\uDBFF](?![\uDC00-\uDFFF]))|(?:(?<![\uD800-\uDBFF])[\uDC00-\uDFFF])/g, '')
    .trim();
}

