  var arts = digest.top_articles  || [];
  var bts  = digest.breakthroughs || [];
  var G    = '#00c882';

  function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')
                        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function pad2(n) { return String(n).length < 2 ? '0'+n : String(n); }

  var btHTML = bts.map(function(b) {
    return '<div style="background:#111;border-left:3px solid '+G+';padding:16px 18px;border-radius:4px;margin-bottom:12px;">' +
      '<div style="font-family:monospace;font-size:13px;color:'+G+';font-weight:700;margin-bottom:4px;">⚡ '+esc(b.title)+'</div>' +
      '<div style="font-size:11px;color:#555;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">'+esc(b.source)+'</div>' +
      '<div style="font-size:13px;color:#aaa;line-height:1.7;">'+esc(b.summary)+'</div>' +
      (b.significance?'<div style="margin-top:8px;font-size:12px;color:'+G+';font-style:italic;">★ '+esc(b.significance)+'</div>':'')+
      (b.url?'<div style="margin-top:8px;"><a href="'+esc(b.url)+'" style="font-family:monospace;font-size:10px;color:#444;text-decoration:none;">↗ Read more</a></div>':'')+
      '</div>';
  }).join('');

  var artHTML = arts.map(function(a,i) {
    return '<div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid #1a1a1a;">' +
      '<span style="font-family:monospace;font-size:24px;font-weight:900;color:'+G+';min-width:36px;line-height:1;flex-shrink:0;">'+pad2(a.rank||i+1)+'</span>' +
      '<div style="flex:1;">' +
      '<div style="font-size:14px;font-weight:700;color:#f0f0f0;margin-bottom:4px;">'+(a.url?'<a href="'+esc(a.url)+'" style="color:#f0f0f0;text-decoration:none;">'+esc(a.title)+'</a>':esc(a.title))+'</div>' +
      '<div style="font-size:11px;color:#444;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">'+esc(a.source)+'</div>' +
      '<div style="font-size:13px;color:#888;line-height:1.7;">'+esc(a.summary)+'</div>' +
      (a.why_it_matters?'<div style="margin-top:6px;font-size:12px;color:'+G+';">→ '+esc(a.why_it_matters)+'</div>':'')+
      '</div></div>';
  }).join('');

  return '<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>' +
    '<body style="margin:0;padding:0;background:#0a0a0a;font-family:Georgia,serif;">' +
    '<div style="max-width:660px;margin:0 auto;background:#0d0d0d;">' +
    '<div style="padding:36px 32px 28px;border-bottom:1px solid #1a1a1a;">' +
    '<div style="font-family:monospace;font-size:10px;color:'+G+';letter-spacing:5px;text-transform:uppercase;margin-bottom:10px;">// daily intelligence · 29 sources</div>' +
    '<div style="font-size:34px;font-weight:900;color:#f0f0f0;line-height:1;">AI &amp; Data Science</div>' +
    '<div style="font-size:34px;font-weight:900;color:'+G+';line-height:1.2;">'+esc(edition||'Daily Edition')+'_</div>' +
    '<div style="margin-top:14px;font-family:monospace;font-size:11px;color:#333;">'+esc(digest.date)+' · Gemini Flash-Lite + Flash · Vertex AI</div>' +
    '</div>' +
    (bts.length?'<div style="padding:28px 32px;border-bottom:1px solid #1a1a1a;"><div style="font-family:monospace;font-size:10px;color:'+G+';letter-spacing:4px;text-transform:uppercase;margin-bottom:18px;">// major breakthroughs</div>'+btHTML+'</div>':'')+
    '<div style="padding:28px 32px;"><div style="font-family:monospace;font-size:10px;color:'+G+';letter-spacing:4px;text-transform:uppercase;margin-bottom:4px;">// top articles</div>'+artHTML+'</div>' +
    '<div style="padding:20px 32px;border-top:1px solid #111;text-align:center;"><div style="font-family:monospace;font-size:10px;color:#222;">AI Digest · GAS · Gemini 2.5 Flash-Lite + Flash · Vertex AI · Free</div></div>' +
    '</div></body></html>';
}